# ── Database ──────────────────────────────────────────────
# PostgreSQL password (also set POSTGRES_PASSWORD in docker-compose)
DB_PASSWORD=change-me

# PostgreSQL connection string (async driver for runtime)
# Note: Update the password here to match DB_PASSWORD above
DATABASE_URL=postgresql+asyncpg://postgres:change-me@localhost:5432/api_csv_import

# Synchronous connection string (for Alembic migrations only)
SYNC_DATABASE_URL=postgresql://postgres:change-me@localhost:5432/api_csv_import

# Test database URL (async SQLite for testing)
TEST_DATABASE_URL=sqlite+aiosqlite:///./test.db

# ── Auth (JWT) ───────────────────────────────────────────
# Secret key for JWT signing — generate with: openssl rand -hex 32
SECRET_KEY=change-me-please-use-a-real-secret-in-production

# JWT algorithm (HS256 is symmetric, RS256 is asymmetric)
ALGORITHM=HS256

# Token expiration time in minutes (default: 30)
ACCESS_TOKEN_EXPIRE_MINUTES=30

# ── Upload Limits ────────────────────────────────────────
# Maximum number of rows per batch upload request
MAX_BATCH_SIZE=1000

# Maximum file size in megabytes for multipart uploads
MAX_FILE_SIZE_MB=10

# ── Rate Limiting ────────────────────────────────────────
# Maximum requests per minute per IP (0 = disabled)
RATE_LIMIT_PER_MINUTE=100

# Per-endpoint rate limits (requests per minute)
TOKEN_RATE_LIMIT=20
UPLOAD_RATE_LIMIT=30

# ── CORS ──────────────────────────────────────────────────
# Comma-separated list of allowed origins (use * for development only)
CORS_ORIGINS=http://localhost:3000,http://localhost:8000

# ── General ──────────────────────────────────────────────
# Enable debug mode (never enable in production)
DEBUG=false

# Application host and port
HOST=0.0.0.0
PORT=8000
